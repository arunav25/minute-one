# --- PyAI (real voice) -------------------------------------------------------
# Secret key. Server-side only: it is never sent to the browser. The SDK gets a
# short-lived, origin-locked session token minted by /api/minute-one/session.
PYAI_API_KEY=

# Which origins may mint a voice token at all. Comma separated; unset means any
# origin that passes the product's own allowlist. This is a gate only — the
# token is always locked to the origin that asked for it, so remember to include
# the scheme you actually serve on. An https page cannot use an http-locked
# token: PyAI refuses the WebSocket with a bare 1006 and no explanation.
PYAI_ALLOWED_ORIGINS=https://localhost:3200,http://localhost:3200

# Token lifetime in seconds. Keep it short; default 120, PyAI max 600.
PYAI_TOKEN_TTL_SECONDS=120

# Optional. A Voice Agent created in the PyAI console (console.pyai.com/agents).
# Bound by passing it as the session label: an agent profile "applies
# automatically when connecting with session_label={agent_id}" (@pyai/sdk
# typings, OmniConfigure.language). That supplies the agent's voice and
# language; Minute One still sends its own persona and tools per session, and an
# inline value wins for that session. Leave empty to run with no agent profile.
PYAI_AGENT_ID=

# --- demo ---------------------------------------------------------------------
# Shown on the phone-help card. Not dialled automatically.
NEXT_PUBLIC_HELP_NUMBER=+1 415 555 0100
