# --- Voice providers --------------------------------------------------------
# The server advertises whichever of these it holds a key for, in this order,
# and the widget falls back to the next if a socket refuses to open. Set both
# for a live safety net; set either one to run on just that vendor.
#
# PyAI Omni — the default whenever this key is present. Server-side only; the
# browser receives a short-lived token minted by /api/minute-one/session.
PYAI_API_KEY=
PYAI_ALLOWED_ORIGINS=https://localhost:3200,http://localhost:3200
PYAI_TOKEN_TTL_SECONDS=60
# Optional: adopt a Voice Agent configured in the PyAI console.
PYAI_AGENT_ID=

# Deepgram — the automatic fallback, and the default with no PyAI key.
DEEPGRAM_API_KEY=

# Extra spend gate for pages that request temporary voice tokens. Comma
# separated. The product's stored allowed origins are checked as well. On
# Vercel, add your deployment origin, e.g. https://minute-one-ten.vercel.app
DEEPGRAM_ALLOWED_ORIGINS=https://localhost:3200,http://localhost:3200

# Temporary token lifetime. Minute One clamps this to 30-300 seconds.
DEEPGRAM_TOKEN_TTL_SECONDS=60

# Current Deepgram Voice Agent model choices. These are identifiers, not secrets.
DEEPGRAM_LISTEN_MODEL=flux-general-en
DEEPGRAM_THINK_MODEL=gpt-4o-mini
DEEPGRAM_SPEAK_MODEL=aura-2-thalia-en

# Shown on the phone-help card. Not dialled automatically.
NEXT_PUBLIC_HELP_NUMBER=+1 415 555 0100

# --- Semantic knowledge base (embeddings) ------------------------------------
# The voice agent retrieves help-center context at answer time via the
# search_knowledge tool. Both the ingest script and the search endpoint embed
# text with this provider; the model MUST be identical on both sides or cosine
# search returns nonsense. Server-side only — the browser never sees this key.
#
# EMBEDDING_API_KEY falls back to OPENAI_API_KEY if unset.
OPENAI_API_KEY=
# EMBEDDING_API_KEY=
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-small

# --- NeonDB (products + knowledge base) --------------------------------------
# Postgres + pgvector connection string. When set, products and the semantic
# knowledge base are stored in Neon — required on Vercel, whose serverless
# filesystem is ephemeral. When unset, both fall back to a local JSON file
# under .data (fine for offline dev and tests). Holds a password: never commit.
DATABASE_URL=

# Optional: local file fallback location when DATABASE_URL is unset.
# MINUTE_ONE_DATA_DIR=.data
