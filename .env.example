# Deepgram secret. Server-side only. The browser receives a temporary bearer
# token minted by /api/minute-one/session, never this API key.
DEEPGRAM_API_KEY=

# Extra spend gate for pages that request temporary voice tokens. Comma
# separated. The product's stored allowed origins are checked as well.
DEEPGRAM_ALLOWED_ORIGINS=https://localhost:3200,http://localhost:3200

# Temporary token lifetime. Minute One clamps this to 30-300 seconds.
DEEPGRAM_TOKEN_TTL_SECONDS=60

# Current Deepgram Voice Agent model choices. These are identifiers, not secrets.
DEEPGRAM_LISTEN_MODEL=flux-general-en
DEEPGRAM_THINK_MODEL=gpt-4o-mini
DEEPGRAM_SPEAK_MODEL=aura-2-thalia-en

# Shown on the phone-help card. Not dialled automatically.
NEXT_PUBLIC_HELP_NUMBER=+1 415 555 0100
