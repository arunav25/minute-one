{
  "name": "minute-one",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Verified conversational onboarding. A voice guide that refuses to advance until the intended result is proven.",
  "scripts": {
    "dev": "next dev -p 3200",
    "demo": "npm run build:sdk && next dev -H 127.0.0.1 -p 3200",
    "build": "npm run build:sdk && next build --webpack",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:sdk": "node scripts/build-sdk.mjs",
    "dev:https": "npm run dev:cert && npm run build:sdk && next dev -p 3200 --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem",
    "dev:cert": "node scripts/dev-cert.mjs"
  },
  "dependencies": {
    "@deepgram/agents": "0.1.1",
    "@minute-one/core": "*",
    "@minute-one/voice-deepgram": "*",
    "@minute-one/voice-mock": "*",
    "@minute-one/voice-pyai": "*",
    "@minute-one/web": "*",
    "@neondatabase/serverless": "^1.1.0",
    "@pyai/sdk": "^0.2.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "22.10.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "^0.24.0",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunav25/minute-one.git"
  },
  "homepage": "https://minute-one-ten.vercel.app",
  "bugs": {
    "url": "https://github.com/arunav25/minute-one/issues"
  },
  "keywords": [
    "onboarding",
    "voice-agent",
    "activation",
    "product-tour",
    "rag",
    "deepgram",
    "saas",
    "user-onboarding",
    "voice-ai"
  ],
  "engines": {
    "node": ">=22"
  }
}
